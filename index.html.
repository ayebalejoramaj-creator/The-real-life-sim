function clamp(v){return Math.max(0,Math.min(100,v))}
function renderAssets(){el("assets").innerHTML=`<div class="span12"><h3>Cars</h3><div class="grid" style="margin:0">${cars.map((a,i)=>assetCard(a,"car"+i)).join("")}</div><h3 style="margin-top:12px">Homes</h3><div class="grid" style="margin:0">${homes.map((a,i)=>assetCard(a,"home"+i)).join("")}</div></div>`;}
function assetCard(a,id){let owned=state.owned.includes(id),price=a[1];return `<div class="asset span12"><b>${a[0]}</b><div class="small">${a[2]}</div><div class="price">${fmt(price)}</div><button class="btn secondary" style="margin-top:8px;width:100%" ${owned?"disabled":""} onclick="purchase('${id}')">${owned?"Owned":state.cash>=price?"Purchase milestone":"Not yet affordable"}</button></div>`;}
let pending=null;
function purchase(id){let list=id.startsWith("car")?cars:homes,a=list[+id.replace(/\D/g,"")];if(!a||state.owned.includes(id)||state.cash<a[1])return;pending={id,a};el("modalTitle").textContent=a[0];el("modalText").textContent=`This costs ${fmt(a[1])}. It is a game milestone, not a real listing. Your remaining cash would be ${fmt(state.cash-a[1])}. Consider whether you have enough left for other needs.`;el("modal").classList.remove("hidden");}
el("buyConfirm").onclick=()=>{if(!pending)return;state.cash-=pending.a[1];state.owned.push(pending.id);state.xp+=10;log("Milestone acquired: "+pending.a[0]+". Remember that ownership also brings ongoing costs.");pending=null;el("modal").classList.add("hidden");update();};
el("buyCancel").onclick=()=>{pending=null;el("modal").classList.add("hidden")};
el("careerSet").onclick=careerChange;
el("start").onclick=startChallenge;
