el("rest").onclick=()=>{state.well=clamp(state.well+8);state.xp+=2;log("You took a balanced day: recovery supports long-term performance. +2 XP, +8 life balance.");update();};
el("family").onclick=()=>{let q=family[Math.floor(Math.random()*family.length)];el("familyResult").innerHTML=`<b>${q.q}</b><br>${q.a.map((a,i)=>`<button class="choice" data-f="${i}">${a}</button>`).join("")}`;[...el("familyResult").querySelectorAll("button")].forEach(b=>b.onclick=()=>{let good=+b.dataset.f===q.good;state.xp+=good?4:1;state.skills.people=clamp(state.skills.people+(good?3:0));el("familyResult").innerHTML=`<span class="${good?"good":"bad"}"><b>${good?"Good approach":"Something to reconsider"}</b></span><br>${q.learn}`;update();log("Family/community side quest: "+q.learn);});};
