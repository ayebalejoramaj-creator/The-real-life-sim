const scenarios=[
{sector:"Finance",title:"A too-good-to-be-true return",text:"A contact offers a guaranteed 25% monthly return if you transfer UGX 300,000 today. They show screenshots, but you cannot verify the source. They say asking too many questions means you lack ambition.",tip:"Separate evidence from persuasion. Check regulation, custody, risks and written terms independently. Never invest money you cannot afford to lose.",opts:[
["Transfer today before the offer closes.",-8,-4,-2,0,"Urgency and guaranteed high returns are warning signs. You have no verified business model or enforceable terms."],
["Ask for independently verifiable records, regulatory status, risk disclosures and time to review.",9,8,4,3,"You resisted pressure and asked for evidence. A legitimate opportunity should withstand reasonable due diligence."],
["Send a small amount just to test them.",-2,1,1,1,"A small test still exposes you and may be used to build trust before a larger request. Verify first."]
]},
{sector:"Technology",title:"The product launch is failing",text:"Your small app has 200 sign-ups but only 8 active users. A competitor has launched a similar product. Your team wants to spend the remaining budget on flashy advertising.",tip:"A product needs evidence of a real user problem, retention and a sustainable acquisition path—not just downloads.",opts:[
["Spend the remaining budget on ads immediately.",-5,-4,-2,0,"More traffic will not fix a product users do not return to. You need to understand the drop-off first."],
["Interview users, inspect the onboarding funnel and test one improvement before scaling marketing.",9,9,4,3,"Excellent product thinking: diagnose before spending, then run a measurable experiment."],
["Copy the competitor's newest features.",1,0,1,1,"Competitor research is useful, but copying features without understanding your users can waste time."]
]},
{sector:"Health & Science",title:"Conflicting health information",text:"A relative sends a viral post claiming a common medicine is dangerous and urges everyone to stop taking it. Another family member is currently using that medicine under a clinician's care.",tip:"Do not make medication changes based on forwarded posts. Check trusted health authorities and consult the treating clinician or pharmacist.",opts:[
["Tell everyone to stop taking it immediately.",-9,-5,-4,0,"That could cause harm. Medication changes should be guided by a qualified professional who knows the person's circumstances."],
["Check reputable health guidance and encourage the person to speak to their clinician or pharmacist before changing anything.",9,8,6,3,"You protect safety, avoid amplifying misinformation and direct the person to qualified advice."],
["Ignore all health information online, including official sources.",0,-2,1,1,"Scepticism is useful, but reliable public-health information can help when checked against authoritative sources."]
]},
{sector:"Business & Trade",title:"A major customer wants credit",text:"A new customer asks for stock worth UGX 700,000 on 30-day credit and promises a much larger order next month. You have never worked with them, and the stock represents most of your working capital.",tip:"Think about cash conversion, customer verification, written terms, deposits and the cost of a late or unpaid invoice.",opts:[
["Release all stock because the future order could be huge.",-8,-5,-2,0,"A promised future order is not guaranteed. You have concentrated too much working capital in one untested customer."],
["Verify the customer, check references and offer a smaller first order with a deposit and written terms.",9,8,5,3,"A sensible pilot limits exposure while testing whether the customer pays reliably."],
["Reject them rudely and block the contact.",1,0,-3,1,"Declining risky credit may be wise, but professional communication preserves options and reputation."]
]},
{sector:"Engineering & Infrastructure",title:"The deadline versus safety",text:"A construction supervisor says a safety inspection can be skipped to meet a deadline. They insist the work looks fine and promise to take responsibility if anything goes wrong.",tip:"Safety-critical work requires proper inspection, documentation and qualified sign-off. Schedule pressure does not remove responsibility.",opts:[
["Skip the inspection to protect the deadline.",-10,-3,-3,0,"You accepted avoidable safety and legal risk. A visual impression is not a substitute for required inspection."],
["Pause the affected work, document the concern and request the required qualified inspection.",9,8,6,3,"You prioritised safety and traceability. Escalate through the proper site process."],
["Argue loudly in front of everyone.",0,0,-4,1,"Raising the issue matters, but a calm, documented escalation is more effective and less likely to distract from safety."]
]},
{sector:"Education",title:"A learner is falling behind",text:"A student in your group repeatedly misses deadlines. Other members want them removed from the project. You learn they may not understand one key concept, but nobody has checked.",tip:"Good leadership combines accountability with curiosity. Identify the barrier, agree on a clear contribution and keep the whole team informed.",opts:[
["Remove them immediately without discussion.",-2,-2,-2,0,"You may solve the immediate workload problem but miss a fixable learning or communication issue."],
["Speak privately, identify the obstacle, agree on a specific task and checkpoint, then review progress.",9,9,7,3,"You combined empathy with accountability and made the next step measurable."],
["Do their part yourself and say nothing.",-3,-1,1,0,"This may help once, but it hides the problem and creates an unfair, unsustainable pattern."]
]},
{sector:"Agriculture & Environment",title:"The harvest decision",text:"A buyer offers to purchase your entire harvest immediately at a lower price than you expected. You have limited storage, and weather forecasts suggest heavy rain next week.",tip:"Compare net proceeds, spoilage risk, storage cost, transport, buyer reliability and the value of splitting the sale.",opts:[
["Reject the offer because your expected price must be right.",-3,-2,-1,0,"Holding out may pay off, but your expected price is not guaranteed and spoilage can erase the upside."],
["Compare current net offers, storage and weather risk; consider selling a portion now and diversifying buyers.",9,9,5,3,"You are managing uncertainty rather than trying to predict one perfect price."],
["Accept without checking weighing, grading or payment terms.",-5,-3,-2,0,"A quick sale can be sensible, but unclear measurements and payment terms invite disputes."]
]},
{sector:"Creative & Media",title:"A viral post with false claims",text:"A post using your video is spreading quickly, but it falsely claims a local business cheated customers. Sharing it would boost your audience. You have not verified the allegation.",tip:"Reach is not worth avoidable harm. Verify claims, distinguish opinion from fact and correct mistakes transparently.",opts:[
["Repost it with an angry caption to gain attention.",-7,-5,-3,0,"You amplify a potentially false allegation and expose yourself and others to reputational and legal consequences."],
["Verify with credible sources, contact the parties where appropriate and avoid presenting unconfirmed claims as fact.",9,9,5,3,"You chose accuracy and fairness over short-term engagement."],
["Delete your own content and never discuss the issue.",1,0,2,1,"Avoiding amplification is sensible, but responsible reporting or a careful correction may still be useful."]
]},
{sector:"Transport & Logistics",title:"A delivery route is disrupted",text:"A key road is blocked and several deliveries are late. A client is demanding an exact arrival time, but you do not yet know how long the diversion will take.",tip:"Communicate uncertainty honestly, give a realistic update window and prioritise safety and high-impact deliveries.",opts:[
["Invent an arrival time to calm the client.",-5,-4,-3,0,"False certainty damages trust when the estimate fails. Communicate what is known and when you will update."],
["Check route options, reprioritise urgent deliveries and give clients a transparent update with a next check-in time.",9,8,7,3,"You managed operations and expectations without pretending to know more than you do."],
["Wait silently until the problem is solved.",-3,-2,-2,0,"Silence creates uncertainty for customers who may be able to make alternative arrangements."]
]},
{sector:"Hospitality & Tourism",title:"A guest complaint",text:"A guest says their room is not ready despite a confirmed check-in time. The hotel is full, and the front desk is busy. The guest is upset but speaking calmly.",tip:"Listen, acknowledge the inconvenience, check the facts and offer realistic options without promising what operations cannot deliver.",opts:[
["Blame housekeeping in front of the guest.",-4,-2,-4,0,"Blame does not solve the guest's problem and undermines team trust."],
["Apologise, verify the room status, offer available alternatives and give a specific update time.",9,8,8,3,"You combined service recovery with operational follow-through."],
["Promise an upgrade without checking availability.",-2,-1,-2,1,"A generous promise can create a second failure if the option is unavailable. Verify before offering."]
]},
{sector:"Public Service & Law",title:"A favour in the queue",text:"Someone offers you money to move their application ahead of other people. They say everyone does it and no one will know. You are responsible for processing applications fairly.",tip:"Fair process, transparency and conflict-of-interest controls protect both the public and the institution.",opts:[
["Accept because it is a small amount.",-10,-5,-5,0,"This is a misuse of entrusted responsibility and can harm people waiting fairly."],
["Decline, document the approach if policy requires it and follow the official queue and reporting process.",9,9,7,3,"You protected fairness and your professional integrity."],
["Move the application ahead but refuse the money.",-5,-2,-3,0,"Even without payment, favouritism undermines fair process. Apply the same rules to everyone."]
]},
{sector:"Sports & Entertainment",title:"The sponsorship offer",text:"A brand offers to sponsor your sports career, but the contract includes broad rights to your image for many years and unclear performance obligations. They want your signature today.",tip:"Understand duration, exclusivity, payment, deliverables, termination, image rights and dispute terms. Get qualified advice before signing.",opts:[
["Sign immediately; sponsorship is hard to get.",-7,-3,-2,0,"A valuable opportunity can still contain costly terms. Do not let excitement replace contract review."],
["Request the full contract, clarify obligations and seek independent professional advice before signing.",9,9,5,3,"You protect long-term options while treating the opportunity seriously."],
["Reject all sponsorships permanently.",1,0,1,1,"Caution is sensible, but careful review can help distinguish fair opportunities from harmful ones."]
]},
{sector:"Real Estate & Construction",title:"The property deposit",text:"An agent offers a house at an unusually attractive price and asks for a deposit before you can inspect the property or verify ownership documents. They say another buyer is waiting.",tip:"Property transactions require independent title and ownership checks, physical verification, written terms and qualified local legal advice.",opts:[
["Pay the deposit to secure the bargain.",-9,-5,-3,0,"Pressure plus no verification is a serious warning. Recovering a deposit can be difficult."],
["Arrange an inspection and independent legal/title checks before any payment; verify the agent's authority.",9,9,5,3,"You made verification a condition of commitment, which is essential in high-value transactions."],
["Send a photo of your ID and ask them to hold it.",-4,-2,-1,0,"Sharing identity documents does not establish ownership or protect your deposit. Verify the property and counterparty."]
]}
];
const family=[
{q:"A family member disagrees with a practical decision you made. What is the most constructive first move?",a:["Listen to their concern, explain your reasoning and look for the facts you may both be missing.","Try to win the argument quickly.","Avoid them until they agree."],good:0,learn:"Listening is not surrender. It helps uncover information and preserves trust while you still make your own decision."},
{q:"A shared household task keeps being forgotten. What would help most?",a:["Agree on clear ownership, a realistic schedule and a simple reminder.","Complain each time it happens.","Assume someone else will handle it."],good:0,learn:"Shared systems reduce repeated friction. Clear responsibilities work better than vague expectations."},
{q:"A younger person asks you for career advice, but you are unsure of the answer.",a:["Admit what you don't know and help them find reliable information or someone experienced.","Make up a confident answer.","Tell them the choice is entirely theirs and disengage."],good:0,learn:"Good mentoring models intellectual honesty and shows how to find trustworthy guidance."},
{q:"A community project has a small budget and many competing needs.",a:["Ask affected people what matters most, set transparent priorities and track spending.","Let the loudest person decide.","Spend the money quickly so the project looks active."],good:0,learn:"Inclusive prioritisation and transparent budgeting build trust and improve outcomes."}
];
const cars=[["Used compact car",18000000,"Entry asset · transport"],["Performance coupe",95000000,"Sports car · high running costs"],["Luxury sports car",280000000,"Premium milestone · substantial upkeep"]];
const homes=[["Starter home",85000000,"A first property milestone"],["Modern family house",240000000,"More space · maintenance costs"],["Architect-designed residence",650000000,"High-end milestone · significant upkeep"]];
let state={cash:500000,xp:0,rep:10,well:70,turn:0,career:careers[0][0],sector:"Technology",skills:{reasoning:50,people:50,execution:50,financial:50},owned:[],current:null,done:false};
let rivals=[{n:"Maya Chen",style:"Research-led",score:0,rep:62},{n:"Daniel Okello",style:"Fast operator",score:0,rep:58},{n:"Amina Patel",style:"People-first",score:0,rep:65},{n:"Kato Mensah",style:"Risk manager",score:0,rep:60}];
const el=id=>document.getElementById(id),fmt=n=>"UGX "+Math.round(n).toLocaleString("en-US");
function initSelects(){el("career").innerHTML=careers.map(c=>`<option>${c[0]}</option>`).join("");el("sector").innerHTML=sectors.map(s=>`<option>${s}</option>`).join("");}
function update(){el("cash").textContent=fmt(state.cash);el("xp").textContent=state.xp;el("rep").textContent=state.rep;el("level").textContent=1+Math.floor(state.xp/30);el("well").textContent=state.well;el("round").textContent=state.turn+"/12";
 el("skills").innerHTML=Object.entries(state.skills).map(([k,v])=>`<div class="small" style="text-transform:capitalize">${k} · ${v}/100</div><div class="bar"><i style="width:${v}%"></i></div>`).join("");
 el("agents").innerHTML=[...rivals].sort((a,b)=>b.score-a.score).map((r,i)=>`<div class="agent"><div><b>${i+1}. ${r.n}</b><div class="small">${r.style}</div></div><div style="text-align:right"><b>${r.score} XP</b><div class="small">Rep ${r.rep}</div></div></div>`).join("");
 renderAssets();}
function log(msg){const d=document.createElement("div");d.className="event";d.textContent=msg;el("log").prepend(d);}
