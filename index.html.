function startChallenge(){if(state.turn>=12){el("missionTitle").textContent="Season complete";el("missionText").textContent="You completed 12 challenges. Review your learning log, improve your skills and restart to play a new season.";el("options").innerHTML="";el("next").disabled=true;return}
 let pool=scenarios.filter(s=>s.sector===state.sector);if(!pool.length)pool=scenarios;state.current=pool[Math.floor(Math.random()*pool.length)];el("missionMeta").textContent="Turn "+(state.turn+1)+" · "+state.current.sector;el("missionTitle").textContent=state.current.title;el("missionText").textContent=state.current.text;el("missionTip").textContent="Think about: "+state.current.tip;el("debrief").classList.add("hidden");el("next").disabled=true;
 el("options").innerHTML=state.current.opts.map((o,i)=>`<button class="choice" data-i="${i}"><strong>${String.fromCharCode(65+i)}. ${o[0]}</strong><span class="small">Choose this response</span></button>`).join("");
 [...el("options").querySelectorAll("button")].forEach(b=>b.onclick=()=>resolve(+b.dataset.i));}
function resolve(i){const s=state.current,o=s.opts[i];if(!o)return;[...el("options").querySelectorAll("button")].forEach(b=>b.disabled=true);
 state.skills.reasoning=clamp(state.skills.reasoning+o[1]);state.skills.financial=clamp(state.skills.financial+(s.sector==="Finance"||s.sector==="Business & Trade"?o[1]:Math.round(o[1]/2)));state.skills.people=clamp(state.skills.people+o[2]);state.skills.execution=clamp(state.skills.execution+o[3]);
 state.xp+=Math.max(1,o[4]*5);state.rep=clamp(state.rep+o[4]*2);state.cash=Math.max(0,state.cash+(o[4]===3?15000:o[4]===2?5000:o[4]===1?0:-10000));state.turn++;
