h1{font-size:clamp(29px,5vw,48px);line-height:1.02;margin:24px 0 7px}h2{font-size:22px;margin:4px 0 10px}h3{font-size:16px;margin:0 0 8px}.muted{color:var(--muted)}.small{font-size:12px;color:var(--muted)}
